# Copy to `.env` beside compose.yaml. Nothing secret belongs in here: every
# secret is a file under deploy/secrets/, generated by deploy/init-secrets.sh
# and mounted by compose.

# The image to run, pinned to a release tag. `latest` and `main` both move, and
# a deployment pinned to a moving tag is pinned to nothing: it cannot say
# afterwards what it was running. Build it yourself instead with
# deploy/build-image.sh, which prints the line to put here.
PAINFREE_IMAGE=ghcr.io/reyemb/painfree:0.2.0
# PAINFREE_IMAGE=localhost/painfree:0.2.0

# What the proxy serves. A real hostname gets a publicly trusted certificate
# automatically; `https://painfree.localhost` gets one from Caddy's own local CA,
# which is what makes the stack runnable with no DNS and no internet.
#
# Two things a `.localhost` name needs, and neither is obvious:
#
#   glibc resolves `localhost` and nothing under it, so Debian, Ubuntu and WSL
#   do not resolve `painfree.localhost` at all while every health check stays
#   green. Add it to /etc/hosts:  127.0.0.1  painfree.localhost
#
#   the local CA's root is served at /local-ca.crt, unauthenticated, because the
#   console is behind the certificate the browser is warning about. Import it
#   and the warning stops.
#
# No port here. The ports below decide that, and the proxy follows them.
PAINFREE_SITE_ADDRESS=https://painfree.localhost

# Where the proxy listens, inside the container and on the host, as one pair of
# numbers: the Caddyfile reads the ports and compose publishes the same ones, so
# the site address above never carries a port and cannot disagree with them.
#
# High and on loopback by default, because a rootless engine may not publish
# below net.ipv4.ip_unprivileged_port_start (1024 on a stock Ubuntu), and podman
# is rootless by default. For a real hostname set all four to 80 and 443:
# a publicly trusted certificate is issued over those ports or not at all.
PAINFREE_HTTP_PORT=8080
PAINFREE_HTTPS_PORT=8443
PAINFREE_HTTP_BIND=127.0.0.1:8080
PAINFREE_HTTPS_BIND=127.0.0.1:8443

# How people and programs sign in. Two supported answers, and leaving this
# empty picks one of them for you:
#
#   an identity provider   fill in the four OIDC lines below; the mode resolves
#                          to `oidc` and browsers sign in through the provider.
#   no identity provider   leave the OIDC lines empty; the mode resolves to
#                          `basic` and this deployment issues its own accounts.
#                          Create the first one after the stack is up:
#                            podman exec painfree_api_1 \
#                                python -m painfree create-admin <name>
#                          No account exists until you do, and none is ever
#                          created for you.
#
# Naming a mode here overrides the choice. The proxy terminates TLS either way,
# which `basic` refuses to start without.
PAINFREE_AUTH_MODE=

# The identity provider. Required when the mode is `oidc`, and the issuer must
# be https. Leave every line empty for a deployment that has none.
PAINFREE_OIDC_ISSUER=https://id.example.com/realms/painfree
PAINFREE_OIDC_CLIENT_ID=painfree
# `/auth/callback`, not `/ui/auth/callback`. The console is mounted at /ui and
# the authentication routes are not: the callback is on the `/auth` router, and
# it is one of the five paths that answer without a credential. A redirect URI
# under /ui is registered with the provider, sent in the authorization request,
# and then rejected by this service as an unknown path -- a login that cannot
# complete. It must match what the provider has registered, exactly.
PAINFREE_OIDC_REDIRECT_URI=https://painfree.example.com/auth/callback
# Keycloak keeps roles under realm_access.roles; the default is a flat `roles`.
PAINFREE_OIDC_ROLES_CLAIM=roles
# Where the scopes a token asked for are, if your provider nests them too.
PAINFREE_OIDC_SCOPE_CLAIM=scope

# What every bearer token's `aud` must contain. Empty means the client id above,
# which is right when one client serves both browsers and machines.
#
# It is not right for the usual two-client setup: a public client for the
# browser and a confidential one with a service account for machines. A token
# from the second does not carry the first's id unless the provider is told to
# add it, so every machine call is refused as `wrong_audience` -- and the
# refusal deliberately does not say whether the signature or the audience was
# wrong, which is correct for a caller and unhelpful for you. Name a resource
# audience both clients target and set it here.
#
# PAINFREE_OIDC_AUDIENCE=https://painfree.example.com

# What your directory calls an administrator, and what it calls everyone else.
# Comma-separated, because the group is named by the directory and the directory
# is not reshaped to suit one service. Leave both unset and the names this
# service has always accepted keep working, so an upgrade changes nothing.
#
# Only the first list decides anything: a name in it makes an `admin`. The
# second exists so the names you do use are not logged as unmapped on every
# request. A name in neither still signs in and holds nothing until it is
# granted a connection. Both resolved values are in the `service.starting` line.
#
# PAINFREE_OIDC_ADMIN_ROLE=painfree-admins
# PAINFREE_OIDC_MEMBER_ROLE=painfree-users

PAINFREE_LOG_LEVEL=INFO
